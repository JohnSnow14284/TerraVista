#version 450
#extension GL_ARB_gpu_shader_int64 : enable

layout(local_size_x = 128) in;

#define DRAW_BUFFER_BINDING 1
#define DRAW_COUNT_BUFFER_BINDING 2
#define SECTION_METADATA_BUFFER_BINDING 3
#define VISIBILITY_BUFFER_BINDING 4
#define VISIBILITY_ACCESS
#define INDIRECT_SECTION_LOOKUP_BINDING 5
#define POSITION_SCRATCH_BINDING 6
#define POSITION_SCRATCH_ACCESS writeonly

#ifndef OPAQUE_CAPACITY
#define OPAQUE_CAPACITY 400000
#endif
#ifndef TRANSLUCENT_CAPACITY
#define TRANSLUCENT_CAPACITY 100000
#endif
#ifndef TEMPORAL_CAPACITY
#define TEMPORAL_CAPACITY 100000
#endif

#include "format/section.glsl"
#include "interface/surface.glsl"
#include "interface/commands.glsl"
#include "interface/residency.glsl"
#define HIZ_BINDING 8
#include "visibility/section_test.glsl"
#include "visibility/history.glsl"

// 启用八位整数存储扩展。

layout(binding = TRANSLUCENT_DISTANCE_BUFFER_BINDING, std430) restrict buffer TranslucentCommandCount {
    uint[] translucentCommandData;
};

void writeCmd(uint idx, uint limit, uint instance, uint offset, uint quadCount) {
    // 保留调度与读回的原始计数器，并限制写入范围。
    if (idx >= limit) return;
    DrawCommand cmd;
    cmd.count = quadCount * 6;
    cmd.instanceCount = 1;
    cmd.firstIndex = 0;
    cmd.baseVertex = int(offset)<<2;
    cmd.baseInstance = instance;
    cmdBuffer[idx] = cmd;
}

void main() {
    if (gl_GlobalInvocationID.x >= min(sectionCount, uint(indirectLookup.length()))) {
        return;
    }
    uint sectionId = indirectLookup[gl_GlobalInvocationID.x];
    SectionMeta meta = sectionData[sectionId];
    uint detail = extractDetail(meta);
    ivec3 ipos = extractPosition(meta);

    vec3 cornerPos = vec3(((ipos<<detail)-baseSectionPos)<<5)-cameraSubPos;

    // 在命令生成时执行区块细化与可见性跟踪。
    // 使用层级遍历已生成的保守队列。
    if (refine!=0u && occluded(meta)) return;
    uint dat = recordVisibility(sectionId);

    // 检查区块是否在当前帧可见。
    bool shouldRender = (dat&0x7fffffffu) == frameId;
    bool renderTemporally = (dat&0x80000000u)==0;// 处理上一帧不可见的区块。

    if (shouldRender) {

        uint ptr = extractQuadStart(meta);
        ivec3 relative = ipos-(baseSectionPos>>detail);
        uint drawId = gl_GlobalInvocationID.x;

        positionBuffer[drawId] = extractRawPos(meta);
        uvec4 counts = meta.b;

        uint msk = 0;
        bool curved = worldCurveData.x != 0.0;
        msk |= uint(((counts.y      &0xFFFFu)!=0) && (curved || relative.y>-1))<<0;
        msk |= uint((((counts.y>>16)&0xFFFFu)!=0) && (curved || relative.y<1 ))<<1;
        msk |= uint(((counts.z      &0xFFFFu)!=0) && (curved || relative.z>-1))<<2;
        msk |= uint((((counts.z>>16)&0xFFFFu)!=0) && (curved || relative.z<1 ))<<3;
        msk |= uint(((counts.w      &0xFFFFu)!=0) && (curved || relative.x>-1))<<4;
        msk |= uint((((counts.w>>16)&0xFFFFu)!=0) && (curved || relative.x<1 ))<<5;

        msk |= uint(((counts.x>>16)&0xFFFFu)!=0)<<6;

        #ifdef COMPACT_COMMANDS
        // 仅合并相邻可见范围，跳过被剔除的非空面组。
        // 将合并结果限制在索引缓冲的六万五千五百三十五个四边形内。
        uint starts[7], lengths[7];
        uint cmdCnt = 0u;
        uint cursor = ptr + (counts.x & 0xffffu);
        for (uint group = 0u; group < 7u; group++) {
            uint amount = group == 0u ? counts.x >> 16u
                    : (counts[(group + 1u) >> 1u] >> (((group - 1u) & 1u) * 16u)) & 0xffffu;
            uint bit = group == 0u ? 6u : group - 1u;
            if ((msk & (1u << bit)) != 0u) {
                if (cmdCnt != 0u && starts[cmdCnt - 1u] + lengths[cmdCnt - 1u] == cursor
                        && lengths[cmdCnt - 1u] + amount <= 65535u) {
                    lengths[cmdCnt - 1u] += amount;
                } else {
                    starts[cmdCnt] = cursor;
                    lengths[cmdCnt] = amount;
                    cmdCnt++;
                }
            }
            cursor += amount;
        }
#else
        uint cmdCnt = bitCount(msk);
#endif
        uint cmdPtr = atomicAdd(opaqueDrawCount, cmdCnt);

        uint tCmdPtr = 0;
        if (renderTemporally) {
            tCmdPtr = atomicAdd(temporalOpaqueDrawCount, cmdCnt) + TEMPORAL_OFFSET;
        }

        uint count = 0;
        // 生成透明绘制数据。
        count = counts.x&0xFFFFu;
        if (count != 0) {
            uint slot = atomicAdd(translucentDrawCount, 1);
            if (slot < TRANSLUCENT_CAPACITY) {
                uvec3 absRel = abs(relative);
                uint distToCamera = (absRel.x+absRel.y+absRel.z)<<detail;
                // 仅将已接收的条目计入排序直方图。
                distToCamera = (TRANSLUCENT_WRITE_BASE-1)-min(distToCamera, (TRANSLUCENT_WRITE_BASE-1));
                // 以二十二位保存队列索引并保留十位距离桶。
                // 排序阶段直接使用已计算的距离桶。
                translucentCommandData[slot+TRANSLUCENT_WRITE_BASE] = drawId | (distToCamera << 22u);
                atomicAdd(translucentCommandData[distToCamera], 1);
            }
        }
        ptr += count;

#ifdef COMPACT_COMMANDS
        for (uint run = 0u; run < cmdCnt; run++) {
            writeCmd(cmdPtr++, OPAQUE_CAPACITY, drawId, starts[run], lengths[run]);
            if (renderTemporally) {
                writeCmd(tCmdPtr++, TEMPORAL_OFFSET + TEMPORAL_CAPACITY, drawId, starts[run], lengths[run]);
            }
        }
#else
        // 处理双面四边形。
        count = (counts.x>>16)&0xFFFFu;
        if (count != 0) {
            writeCmd(cmdPtr++, OPAQUE_CAPACITY, drawId, ptr, count);
            if (renderTemporally) {
                writeCmd(tCmdPtr++, TEMPORAL_OFFSET + TEMPORAL_CAPACITY, drawId, ptr, count);
            }
        }
        ptr += count;

        // 处理底面。
        count = (counts.y)&0xFFFFu;
        if (((msk&(1u<<0))!=0)) {
            writeCmd(cmdPtr++, OPAQUE_CAPACITY, drawId, ptr, count);
            if (renderTemporally) {
                writeCmd(tCmdPtr++, TEMPORAL_OFFSET + TEMPORAL_CAPACITY, drawId, ptr, count);
            }
        }
        ptr += count;

        // 处理顶面。
        count = (counts.y>>16)&0xFFFFu;
        if ((msk&(1u<<1))!=0) {
            writeCmd(cmdPtr++, OPAQUE_CAPACITY, drawId, ptr, count);
            if (renderTemporally) {
                writeCmd(tCmdPtr++, TEMPORAL_OFFSET + TEMPORAL_CAPACITY, drawId, ptr, count);
            }
        }
        ptr += count;

        // 处理北面。
        count = (counts.z)&0xFFFFu;
        if ((msk&(1u<<2))!=0) {
            writeCmd(cmdPtr++, OPAQUE_CAPACITY, drawId, ptr, count);
            if (renderTemporally) {
                writeCmd(tCmdPtr++, TEMPORAL_OFFSET + TEMPORAL_CAPACITY, drawId, ptr, count);
            }
        }
        ptr += count;

        // 处理南面。
        count = (counts.z>>16)&0xFFFFu;
        if ((msk&(1u<<3))!=0) {
            writeCmd(cmdPtr++, OPAQUE_CAPACITY, drawId, ptr, count);
            if (renderTemporally) {
                writeCmd(tCmdPtr++, TEMPORAL_OFFSET + TEMPORAL_CAPACITY, drawId, ptr, count);
            }
        }
        ptr += count;

        // 处理西面。
        count = (counts.w)&0xFFFFu;
        if ((msk&(1u<<4))!=0) {
            writeCmd(cmdPtr++, OPAQUE_CAPACITY, drawId, ptr, count);
            if (renderTemporally) {
                writeCmd(tCmdPtr++, TEMPORAL_OFFSET + TEMPORAL_CAPACITY, drawId, ptr, count);
            }
        }
        ptr += count;

        // 处理东面。
        count = (counts.w>>16)&0xFFFFu;
        if ((msk&(1u<<5))!=0) {
            writeCmd(cmdPtr++, OPAQUE_CAPACITY, drawId, ptr, count);
            if (renderTemporally) {
                writeCmd(tCmdPtr++, TEMPORAL_OFFSET + TEMPORAL_CAPACITY, drawId, ptr, count);
            }
        }
        ptr += count;

#endif
    }
}
